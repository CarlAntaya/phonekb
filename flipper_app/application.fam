App(
    appid="phone_kb",
    name="Phone Keyboard",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="phone_kb_app",
    stack_size=3 * 1024,
    requires=["gui", "bt"],
    fap_category="USB",
    fap_icon="phone_kb_10px.png",
    fap_version="1.1",
    fap_description="Use your Android phone as a wireless keyboard and touchpad for a USB-connected PC",
    fap_author="CarlAntaya",
    fap_weburl="https://github.com/CarlAntaya/phonekb",
)
